{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "country-names.schema.json",
  "title": "Country names by ISO 3166-1 alpha-2 code",
  "type": "object",
  "minProperties": 1,
  "propertyNames": { "pattern": "^[A-Z]{2}$" },
  "additionalProperties": { "type": "string", "minLength": 1 }
}
