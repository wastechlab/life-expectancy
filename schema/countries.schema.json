{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "countries.schema.json",
  "title": "Life expectancy at birth by country",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "name", "male", "female", "both"],
    "properties": {
      "code": { "description": "ISO 3166-1 alpha-2, plus the user-assigned XK that WPP gives Kosovo.", "type": "string", "pattern": "^[A-Z]{2}$" },
      "name": { "type": "string", "minLength": 1 },
      "male": { "$ref": "#/definitions/years" },
      "female": { "$ref": "#/definitions/years" },
      "both": { "$ref": "#/definitions/years" }
    }
  },
  "definitions": {
    "years": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
  }
}
